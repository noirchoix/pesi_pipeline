# PESI FastAPI backend
PESI_API_KEY=change-me-before-production
PESI_AUTH_MODE=required
PESI_PROJECT_ROOT=.
PESI_RAW_DIR=raw
PESI_OUT_DIR=outputs
PESI_ARTIFACT_DIR=artifacts
PESI_FALLBACK_OUT_DIR=outputs_medium
PESI_FALLBACK_ARTIFACT_DIR=artifacts_medium
PESI_FOOD_CHEMISTRY_DIR=raw/food_chemistry
PESI_FOOD_SOURCE_TOP_N=30
PESI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://172.18.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://172.18.0.1:4173

# Optional server-side AI explanation provider
PESI_AI_ENABLED=false
PESI_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT_SECONDS=45
