# Browser should use the same-origin SvelteKit proxy by default.
VITE_PESI_API_BASE_URL=/api/pesi
VITE_PESI_DIRECT_BACKEND=false

# Optional: frontend passes this to SvelteKit proxy, which forwards to FastAPI.
# Do not put DeepSeek or other model-provider keys in VITE variables.
VITE_PESI_API_KEY=change-me-before-production

# SvelteKit server-side proxy target.
PESI_BACKEND_API_BASE_URL=http://localhost:8000/api/v1
PESI_API_KEY=change-me-before-production
